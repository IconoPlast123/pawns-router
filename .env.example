# ============================================================
#  Router $PAWNS : réglages
#  Copie ce fichier en ".env" (sans ".example") puis remplis-le.
#  Le fichier .env reste sur ta machine : il ne va jamais dans git ni sur le site.
# ============================================================

# --- Mode -----------------------------------------------------
# dry_run = simulation : aucune transaction, de faux claims et de faux pawns.
# live    = réel : vrais claims, vrais achats. Seulement une fois le live validé.
# paused  = réel, mais lecture seule : publie l'état et revérifie les pawns, n'envoie rien.
MODE=dry_run

# --- Réel (live et paused uniquement) -------------------------
# URL RPC Solana privée (Helius, QuickNode, Triton...). Elle contient souvent une clé :
# ne la mets JAMAIS dans le site.
RPC_URL=
# Chemin du fichier qui contient la clé privée du wallet router (export Phantom en base58).
# Ce fichier doit être HORS de tout dossier synchronisé (OneDrive...), sinon la clé est copiée dans le cloud.
# Obligatoire en live. « ~ » = ton dossier utilisateur. Exemples : ~\pawns-router-key.txt ou C:\chemin\vers\router-key.txt
ROUTER_KEY_FILE=
# Adresse publique du router. Suffit pour paused et la répétition, qui ne signent rien.
ROUTER_ADDRESS=
# Adresse du coin $PAWNS (le CA), une fois lancé.
MINT=
# Garde-fou : le mode live refuse de démarrer tant que ce n'est pas "oui".
LIVE_CONFIRMED=

# --- Mécanique ------------------------------------------------
# Montant de chaque pawn, en dollars.
PAWN_USD=3
# Vérification (par simulation) des creator fees en attente toutes les X minutes.
CLAIM_EVERY_MIN=5
# Réclamer seulement quand les fees en attente valent au moins X dollars...
CLAIM_MIN_USD=50
# ... ou quand le dernier claim date d'au moins X heures, si les fees paient au moins un pawn.
CLAIM_MAX_WAIT_H=24
# Vitesse maximale : pas plus de X pawns par minute.
MAX_PAWNS_PER_MIN=30
# SOL toujours gardé dans le router pour payer les frais réseau.
GAS_BUFFER_SOL=0.01
# Revérification du solde de chaque pawn toutes les X minutes.
CHECK_EVERY_MIN=60
# Un point de la courbe du site toutes les X minutes.
HISTORY_EVERY_MIN=30
# Part des creator fees gardée par le dev, en %. 0 = 100 % aux pawns (ce que le site affiche).
DEV_SHARE_PCT=0
# Wallet qui recevrait cette part (seulement si DEV_SHARE_PCT > 0).
DEV_WALLET=
# Sac du dev : adresse PUBLIQUE du wallet qui garde le dev buy, affiché sur le site.
# Lecture seule : le router ne signe jamais rien pour ce wallet. Le router lui-même ne doit garder aucun $PAWNS.
DEV_BAG_WALLET=
# Frais de priorité par transaction, en SOL.
PRIORITY_FEE_SOL=0.00001
# Écart maximal accepté sur le nombre de tokens reçus par achat, en %.
SLIPPAGE_PCT=10

# --- Acheteurs des pawns --------------------------------------
# Pawns #1 à #30 : achetés par les 30 voix de Season 1. Fichier de leurs clés privées, HORS de tout dossier
# synchronisé, colonnes voix,adresse,cle_privee. SECRET. Jamais dans git ni dans le site.
VOICES_KEYS_FILE=~\pawns-voices-wallets.csv
# Liste publique des adresses des voix, pour vérifier les clés (par défaut ../docs/voices-wallets.md).
VOICES_ADDRESSES_FILE=
# Part des tokens qu'une voix garde pour pouvoir commenter sur pump.fun, en %. Le reste va dans le pawn.
VOICE_KEEP_PCT=1

# --- Sortie ---------------------------------------------------
# Où le router écrit le state.json lu par le site.
STATE_FILE=out/state.json
# Aperçu local du site sur http://127.0.0.1:8787 (0 = désactivé).
PREVIEW_PORT=8787

# --- Publication en ligne (facultatif) ------------------------
# Copie publique du state.json sur un GitHub Gist, lue par le site. Vide = pas de publication.
# Identifiant du Gist : la suite de chiffres et de lettres à la fin de son adresse.
STATE_GIST_ID=
# Token GitHub avec le SEUL droit « gist ». SECRET : jamais dans git ni dans le site.
# De préférence dans un fichier hors de tout dossier synchronisé (même règle que la clé du router) :
STATE_GIST_TOKEN_FILE=
# ... ou directement ici (copié dans le cloud si ce dossier est synchronisé) :
STATE_GIST_TOKEN=
# Au plus un envoi toutes les X secondes, seulement si quelque chose a changé, et au moins un toutes les 10 min.
PUBLISH_EVERY_SEC=60

# --- Simulation (dry_run uniquement) --------------------------
# Volume de trading simulé, en dollars par heure.
SIM_VOLUME_USD_PER_HOUR=150000
# Part du volume reversée en creator fees, en %.
SIM_CREATOR_FEE_PCT=0.3
# Market cap simulée au départ, en dollars.
SIM_START_MCAP_USD=8000
# SOL déposé au départ dans le router simulé (le buffer gas).
SIM_FUNDING_SOL=0.01
# Prix du SOL utilisé si l'API de prix ne répond pas.
SOL_USD_FALLBACK=190
